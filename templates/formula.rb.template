# frozen_string_literal: true

# =============================================================================
# Homebrew Formula Template — Private GitHub Release Binary
# =============================================================================
#
# Copy this file to Formula/<project-name>.rb and replace every __PLACEHOLDER__.
#
# Prerequisites for end-users:
#   export HOMEBREW_GITHUB_API_TOKEN="<PAT with repo scope>"
#
# Release asset naming convention (recommended for multi-platform support):
#   <project-name>-<version>-<os>-<arch>.tar.gz
#   e.g. project-x-1.2.3-darwin-arm64.tar.gz
#
# The archive should contain the binary at the top level (or adjust `install`).
# =============================================================================

class __ProjectNameCamelCase__ < Formula
  # desc must be strictly under 80 characters (Homebrew audit limit).
  desc "__DESCRIPTION__"
  homepage "__HOMEPAGE__"
  license "MIT" # or "LicenseRef-Proprietary" for internal-only software
  # Explicit version kept for private tap clarity (automation scripts depend on it).
  version "__VERSION__"

  # Pre-built release binary — no Homebrew bottle required.
  bottle :unneeded

  # Runtime dependencies (installed alongside the formula):
  # depends_on "openssl@3"
  #
  # Build-time dependencies (only when compiling from source):
  # depends_on "go" => :build
  #
  # Pure binary formulas like this one typically need no depends_on stanzas.

  # Homebrew selects the correct stanza for the user's OS/arch at install time.
  on_macos do
    on_arm do
      url "https://github.com/__GITHUB_ORG__/__GITHUB_REPO__/releases/download/v__VERSION__/__ASSET_NAME_DARWIN_ARM64__"
      sha256 "__SHA256_DARWIN_ARM64__"
    end
    on_intel do
      url "https://github.com/__GITHUB_ORG__/__GITHUB_REPO__/releases/download/v__VERSION__/__ASSET_NAME_DARWIN_AMD64__"
      sha256 "__SHA256_DARWIN_AMD64__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/__GITHUB_ORG__/__GITHUB_REPO__/releases/download/v__VERSION__/__ASSET_NAME_LINUX_ARM64__"
      sha256 "__SHA256_LINUX_ARM64__"
    end
    on_intel do
      url "https://github.com/__GITHUB_ORG__/__GITHUB_REPO__/releases/download/v__VERSION__/__ASSET_NAME_LINUX_AMD64__"
      sha256 "__SHA256_LINUX_AMD64__"
    end
  end

  # If you only ship a single universal binary, replace the `on_*` blocks above
  # with a single url/sha256 pair:
  #
  #   url "https://github.com/__GITHUB_ORG__/__GITHUB_REPO__/releases/download/v__VERSION__/__ASSET_NAME__"
  #   sha256 "__SHA256__"

  def install
    # Assumes the release tarball extracts a single binary named __BINARY_NAME__.
    bin.install "__BINARY_NAME__"
  end

  test do
    # Smoke test — use --version when supported, otherwise --help.
    system "#{bin}/__BINARY_NAME__", "--version"
  rescue ErrorDuringExecution
    system "#{bin}/__BINARY_NAME__", "--help"
  end
end
